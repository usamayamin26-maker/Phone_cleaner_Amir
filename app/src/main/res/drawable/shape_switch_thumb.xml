<?xml version="1.0" encoding="utf-8"?>
<!-- The switch thumb, 22 px, larger than its track: grey when off (Figma 1:2058, 1:701), blue when
     on (1:867). The view is "activated" while the switch is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/switch_thumb_on" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/switch_thumb_off" />
        </shape>
    </item>
</selector>
