<?xml version="1.0" encoding="utf-8"?>
<!-- The exit sheet's surface. The Figma file draws no sheet, so this is the dialog card of
     view_app_dialog.xml - dialog_surface on a radius-26 corner with the dialog_stroke hairline -
     with the bottom corners squared off, because a sheet's bottom edge is the screen's. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dialog_surface" />
    <stroke
        android:width="@dimen/_1sdp"
        android:color="@color/dialog_stroke" />
    <corners
        android:topLeftRadius="@dimen/_26sdp"
        android:topRightRadius="@dimen/_26sdp" />
</shape>
