<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 1:518 "Stop Scanning": the radius-16 button in red, from the top start corner to the
     bottom end (the handles run at about 32 degrees; a shape draws the nearest 45), with the same
     highlight as the primary button (1:519). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_primary">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/_13sdp" />
                    <gradient
                        android:angle="315"
                        android:endColor="@color/danger_gradient_end"
                        android:startColor="@color/danger_gradient_start"
                        android:type="linear" />
                </shape>
            </item>
            <item
                android:height="@dimen/_20sdp"
                android:gravity="top">
                <shape android:shape="rectangle">
                    <corners
                        android:topLeftRadius="@dimen/_13sdp"
                        android:topRightRadius="@dimen/_13sdp" />
                    <gradient
                        android:angle="270"
                        android:endColor="@color/primary_highlight_end"
                        android:startColor="@color/primary_highlight"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
