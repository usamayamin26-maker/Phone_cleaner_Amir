<?xml version="1.0" encoding="utf-8"?>
<!-- Figma "Background+Border" behind each Home quick-action icon: a circle with a 148 degree
     white-to-blue gradient (top left to bottom right) and a faint white border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:endColor="@color/action_icon_end"
        android:startColor="@color/action_icon_start"
        android:type="linear" />
    <stroke
        android:width="@dimen/_1sdp"
        android:color="@color/action_icon_stroke" />
</shape>
