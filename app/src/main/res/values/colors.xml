<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's palette, read from the Figma file and named by role. The app is light only, so
         there is no values-night counterpart. Never a raw hex in a layout or in code.

         Where Figma lays a translucent white over the screen background and the surface also
         carries an elevation shadow, the colour here is that translucent white already composited
         over screen_background: Android draws an elevation shadow under the whole outline, so a
         translucent card would show its own shadow through it. -->

    <!-- Screen background (Figma "Background", 1:4211): a flat fill and two radial glows. -->
    <color name="screen_background">#FFF7F9FF</color>
    <color name="screen_glow_lavender">#A6DDD6FE</color>
    <color name="screen_glow_lavender_end">#00DDD6FE</color>
    <color name="screen_glow_blue">#475B8CFF</color>
    <color name="screen_glow_blue_end">#005B8CFF</color>

    <!-- Text -->
    <color name="text_primary">#FF171C35</color>
    <color name="text_title">#E6000000</color>
    <color name="text_value">#B5000000</color>
    <color name="text_label_strong">#FF171A2B</color>
    <color name="text_on_header">#FFFFFFFF</color>
    <color name="text_on_tile">#FFFFFFFF</color>
    <color name="text_on_primary">#FFFFFFFF</color>
    <color name="text_accent">#FF0041FF</color>
    <!-- Splash subtitle and loading line, onboarding Skip. -->
    <color name="text_secondary">#FF5F6475</color>
    <!-- Body text under a title: onboarding subtitles, dialog messages (Figma #5F6475 at 85%). -->
    <color name="text_tertiary">#D95F6475</color>
    <!-- A language name on an unselected Language row (Figma 1:4322). -->
    <color name="text_option">#FF16100E</color>

    <!-- Icons -->
    <color name="icon_back">#FF171A2B</color>
    <color name="icon_chevron">#80000000</color>
    <color name="icon_on_header">#FFFFFFFF</color>
    <color name="icon_accent">#FF0041FF</color>
    <!-- The selected language's tick and the Settings row icons. -->
    <color name="icon_violet">#FF6366F1</color>
    <color name="icon_on_primary">#FFFFFFFF</color>
    <!-- The forward chevron on the Settings rows: lighter than the Device Info one. -->
    <color name="icon_chevron_muted">#995F6475</color>

    <!-- Cards -->
    <color name="card_surface">#FFFFFFFF</color>
    <color name="card_glass">#FFFDFDFF</color>
    <color name="card_power_stroke">#FFE8EEFF</color>
    <!-- Settings and Language rows (Figma 1:4241): 72% white, composited as card_glass, with a
         12% blue hairline. The selected language is a 72% violet-to-blue gradient (1:4308),
         composited over screen_background, with a stronger blue stroke. -->
    <color name="card_row_stroke">#1F4F7CFF</color>
    <color name="card_row_selected_start">#FF8C8FF5</color>
    <color name="card_row_selected_end">#FF7E9FFF</color>
    <color name="card_row_selected_stroke">#FF7997FD</color>
    <!-- The 48 px rounded tile a language flag sits in (1:4309). -->
    <color name="flag_tile_stroke">#FFECE2E0</color>
    <!-- The round tile behind a Settings icon or a language flag. -->
    <color name="circle_tile_fill">#FFEEF2FF</color>
    <color name="circle_tile_stroke">#1F4F7CFF</color>
    <!-- Spot shadow under the white cards: Figma's drop shadow is 8% black, lighter than the
         platform default, so the shadow colour is dimmed (API 28+; older versions keep the
         default). -->
    <color name="card_shadow">#66000000</color>
    <color name="icon_tile_fill">#1F0041FF</color>
    <color name="header_tile_fill">#FFD9E3FF</color>
    <color name="header_tile_stroke">#420041FF</color>
    <color name="battery_header_start">#FFCFEBFF</color>
    <color name="battery_header_end">#FFD9CDFC</color>

    <!-- Home (Figma 34:8). The screen is white under a #638BFF-to-white gradient that runs straight
         down over the top 39% of the frame (317 of 812 px). -->
    <color name="home_background">#FFFFFFFF</color>
    <color name="home_gradient_start">#FF638BFF</color>
    <color name="home_gradient_end">#FFFFFFFF</color>
    <!-- Storage Usage is 80% black and RAM Usage text_primary in Figma (34:141, 34:146). -->
    <color name="text_usage_storage">#CC000000</color>
    <color name="usage_icon_tile">#FFFFFFFF</color>
    <!-- Scan Now (34:39): a white ring with a blue glow round a blue gradient circle. The gradient
         is an image fill in Figma, so its colours are sampled from home_v2.png (unverified). -->
    <color name="scan_ring">#FFFFFFFF</color>
    <color name="scan_shadow">#FF0005FF</color>
    <color name="scan_gradient_start">#FF5BBFF5</color>
    <color name="scan_gradient_center">#FF0A9FF2</color>
    <color name="scan_gradient_end">#FF0080F1</color>
    <color name="icon_on_scan">#FFFFFFFF</color>
    <color name="text_on_scan">#FFFFFFFF</color>
    <color name="ripple_on_scan">#33FFFFFF</color>
    <!-- Quick action cards (34:63): white, with a 10% #172B4D shadow; dimmed here because Android
         adds its own spot alpha (API 28+). Each card has an accent for its icon and arrow, a 10%
         tint of it for the icon tile and a pale fill for the arrow circle. -->
    <color name="card_action_shadow">#99172B4D</color>
    <color name="text_action">#FF172B4D</color>
    <color name="qa_ai_junk_accent">#FF168BEE</color>
    <color name="qa_ai_junk_tile">#1A168BEE</color>
    <color name="qa_ai_junk_arrow_fill">#FFE8F3FD</color>
    <color name="qa_duplicates_accent">#FF8E51FF</color>
    <color name="qa_duplicates_tile">#1A8E51FF</color>
    <color name="qa_duplicates_arrow_fill">#FFF4EEFF</color>
    <color name="qa_app_cleaner_accent">#FF615FFF</color>
    <color name="qa_app_cleaner_tile">#1A615FFF</color>
    <color name="qa_app_cleaner_arrow_fill">#FFEFEFFF</color>
    <color name="qa_wa_accent">#FF00BC7D</color>
    <color name="qa_wa_tile">#1A00BC7D</color>
    <color name="qa_wa_arrow_fill">#FFE6F8F2</color>
    <color name="qa_device_info_accent">#FF38BDF8</color>
    <color name="qa_device_info_tile">#1A38BDF8</color>
    <color name="qa_device_info_arrow_fill">#FFEBF8FE</color>
    <color name="qa_battery_info_accent">#FFFE9A00</color>
    <color name="qa_battery_info_tile">#1AFE9A00</color>
    <color name="qa_battery_info_arrow_fill">#FFFFF5E6</color>

    <!-- The design's switch (view_switch): Power Saving Mode, Keep best one. The "on" thumb is
         Figma 1:867. -->
    <color name="switch_track">#FFDFDFDF</color>
    <color name="switch_thumb_off">#FF7C7C7C</color>
    <color name="switch_thumb_on">#FF0041FF</color>

    <!-- Primary gradient button (Figma "Button", 1:334). -->
    <color name="primary_gradient_start">#FF4F7CFF</color>
    <color name="primary_gradient_center">#FF6366F1</color>
    <color name="primary_gradient_end">#FF8B5CF6</color>
    <color name="primary_button_shadow">#996366F1</color>
    <!-- The highlight over the upper half of the radius-16 primary button (Figma 1:990). -->
    <color name="primary_highlight">#39FFFFFF</color>
    <color name="primary_highlight_end">#00FFFFFF</color>

    <!-- Splash (Figma 1:4189): the logo's 70% white border, the violet glow behind it and the
         loading bar's track. -->
    <color name="splash_logo_stroke">#B3FFFFFF</color>
    <color name="splash_glow">#9E7C6CF7</color>
    <color name="splash_glow_end">#007C6CF7</color>
    <color name="progress_track">#FFEEF2FF</color>

    <!-- Onboarding page indicator: the current page is a primary-gradient pill, the others dots. -->
    <color name="indicator_inactive">#334F7CFF</color>

    <!-- Delete Duplicates (Figma 1:483, 1:528, 1:661). -->
    <!-- Scan progress ring: a 30% blue track under the blue arc (1:510, 1:511). -->
    <color name="progress_ring">#FF0041FF</color>
    <color name="progress_ring_track">#4D0041FF</color>
    <!-- "Stop Scanning" (1:518): red, top start to bottom end. -->
    <color name="danger_gradient_start">#FFFF0004</color>
    <color name="danger_gradient_end">#FF990003</color>
    <!-- The size chips on the results card (1:556) and their round icon. -->
    <color name="chip_fill">#2B4F7CFF</color>
    <color name="chip_icon_fill">#FF7295FB</color>
    <!-- "View All" (1:587). -->
    <color name="text_link">#FF0005FF</color>
    <!-- File sizes under a thumbnail and "Select All" (1:713, 1:688): 85% black. -->
    <color name="text_item_meta">#D9000000</color>
    <!-- A file's check: a grey ring off (1:714), blue with a white tick on (1:886). -->
    <color name="check_ring">#FF6C6C6C</color>
    <color name="check_fill">#FF0041FF</color>
    <!-- "Select All" off: pale blue with a blue ring (1:689). -->
    <color name="select_all_fill">#FFDCE5FF</color>
    <!-- The 70% white hairline round a thumbnail (1:711). -->
    <color name="thumbnail_stroke">#B2FFFFFF</color>
    <color name="thumbnail_placeholder">#FFEEF2FF</color>

    <!-- Dialogs (Figma 1:984, 1:1881, 1:2884): a white card with a 75% white hairline and a violet
         shadow over a dimmed, blurred screen. -->
    <color name="dialog_surface">#FFFFFFFF</color>
    <color name="dialog_stroke">#BFFFFFFF</color>
    <color name="dialog_shadow">#596366F1</color>

    <!-- Pressed states -->
    <color name="ripple_on_light">#1F0041FF</color>
    <color name="ripple_on_primary">#33FFFFFF</color>
    <!-- The PDF icon (resources/ic_pdf.svg). -->
    <color name="pdf_icon_mark">#FFFF2116</color>
    <color name="pdf_icon_page">#FFF5F5F5</color>
    <color name="pdf_icon_text">#FF2C2C2C</color>
    <!-- Rate Us (Figma 1:4356 / 1:4395). -->
    <color name="rate_title_text">#FF000000</color>
    <color name="rate_message_text">#FF666464</color>
    <color name="rate_emoji_ring">#FFF4B400</color>
    <color name="rate_star">#FFFDD835</color>
    <color name="rate_star_highlight">#FFFFFF8D</color>
    <color name="rate_star_shade">#FFF4B400</color>
    <!-- No design: a star not chosen yet. -->
    <color name="rate_star_empty">#FFE8E8EE</color>
    <!-- Scan Now (Figma 1:1648 / 1:1705). -->
    <color name="health_security_icon">#FF448AFF</color>
    <color name="text_check_detail">#C7000000</color>
    <color name="scan_done_ring">#B3FFFFFF</color>
    <color name="scan_button_stroke">#D9FFFFFF</color>
    <color name="scan_again_base">#D9FFFFFF</color>
    <color name="scan_again_start">#EBFFFFFF</color>
    <color name="scan_again_center">#D9EEF2FF</color>
    <color name="scan_again_end">#E6EDE9FE</color>

    <!-- The tint Android puts behind the notification small icon in the shade. -->
    <color name="notification_accent">@color/primary_gradient_start</color>
</resources>
