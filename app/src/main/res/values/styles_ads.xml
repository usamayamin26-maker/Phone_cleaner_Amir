<?xml version="1.0" encoding="utf-8"?>
<!--
    Styles for the ads bundle. Two entries, and neither is a style per view: the icon shape exists
    because ShapeableImageView takes its corner shape as a style rather than an attribute, and the
    loading label is one appearance repeated across all five shimmer placeholders.
-->
<resources>

    <!-- Native ad app icon: slightly rounded corners -->
    <style name="ShapeAppearance.NativeAd.Icon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <!--
        "Loading ad…", centred on every shimmer placeholder. Muted on purpose: it labels a skeleton,
        so it has to read without competing with the shimmer underneath it.

        lineHeight is the AppCompat attribute and is ssp, never android:lineHeight and never sdp -
        the text follows the user's font size and an sdp line box does not, so at font size 2.0 the
        glyphs would grow inside a box that stayed put.
    -->
    <style name="TextAppearance.Ad.LoadingLabel" parent="">
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="fontFamily">@font/roboto_medium</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="lineHeight">@dimen/_13ssp</item>
        <item name="android:textColor">@color/ad_loading_label</item>
    </style>

</resources>
