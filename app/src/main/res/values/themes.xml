<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Light only: there is no dark design, so the app stays light whatever the phone's setting
         and there is no values-night folder. -->
    <style name="Base.Theme.PhoneCleaner" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:colorBackground">@color/screen_background</item>

        <!-- No font is set here on purpose. A theme-level android:fontFamily overrides the
             android:fontFamily a TextView sets for itself, so every label would render in one
             weight. Each TextView names its own weight file instead. -->

        <!-- No android:statusBarColor / android:navigationBarColor: every activity goes
             edge-to-edge through enableEdgeToEdge(), which makes the bars transparent itself. -->
    </style>

    <style name="Theme.PhoneCleaner" parent="Base.Theme.PhoneCleaner" />

    <!-- The design's primary call to action ("Delete 357.47 MB", "Scan Again"): a pill with the
         blue-to-violet gradient and bold white text. Shared by every cleaner screen. -->
    <style name="Widget.PhoneCleaner.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/shape_primary_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:minHeight">@dimen/_48sdp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">@dimen/_19sdp</item>
        <item name="android:paddingEnd">@dimen/_19sdp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">@dimen/_13ssp</item>
        <item name="lineHeight">@dimen/_19ssp</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:elevation">@dimen/_8sdp</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="28">@color/primary_button_shadow</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="28">@color/primary_button_shadow</item>
    </style>

</resources>
