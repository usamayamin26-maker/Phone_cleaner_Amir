<?xml version="1.0" encoding="utf-8"?>
<!-- A size chip on the results card (Figma 1:556): 17% blue pill, 10 / 5 px padding, the 25 px
     round icon and the size 7 px after it, 14 px semi-bold in capitals. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_chip"
    android:gravity="center_vertical"
    android:minWidth="@dimen/_106sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_8sdp"
    android:paddingVertical="@dimen/_4sdp">

    <FrameLayout
        android:layout_width="@dimen/_20sdp"
        android:layout_height="@dimen/_20sdp"
        android:background="@drawable/shape_chip_icon">

        <ImageView
            android:id="@+id/chip_icon"
            android:layout_width="@dimen/_11sdp"
            android:layout_height="@dimen/_11sdp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_image" />
    </FrameLayout>

    <TextView
        android:id="@+id/chip_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp"
        android:fontFamily="@font/roboto_semi_bold"
        android:textAllCaps="true"
        android:textColor="@color/text_title"
        android:textSize="@dimen/_11ssp"
        app:lineHeight="@dimen/_16ssp"
        tools:text="3.75 GB" />
</LinearLayout>
