<?xml version="1.0" encoding="utf-8"?>
<!--
    Loading placeholder for native layout 1. Mirrors native_ad_medium_without_media_right_cta.xml exactly
    (10dp padding + 60dp content = 80dp) so the slot doesn't jump when the ad arrives.
    Keep both files' padding and content height in sync.
-->
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_placeholder"
    android:padding="@dimen/_10sdp"
    app:shimmer_base_alpha="0.5"
    app:shimmer_duration="1000">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_60sdp">

        <View
            android:id="@+id/skeletonIcon"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:background="@drawable/bg_ad_skeleton_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/skeletonTag"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toTopOf="@id/skeletonDescription1"
            app:layout_constraintStart_toEndOf="@id/skeletonIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <View
            android:id="@+id/skeletonHeading"
            android:layout_width="0dp"
            android:layout_height="@dimen/_14sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toBottomOf="@id/skeletonTag"
            app:layout_constraintEnd_toStartOf="@id/skeletonButton"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/skeletonTag"
            app:layout_constraintTop_toTopOf="@id/skeletonTag"
            app:layout_constraintWidth_max="@dimen/_120sdp" />

        <View
            android:id="@+id/skeletonDescription1"
            android:layout_width="0dp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toTopOf="@id/skeletonDescription2"
            app:layout_constraintEnd_toStartOf="@id/skeletonButton"
            app:layout_constraintStart_toStartOf="@id/skeletonTag"
            app:layout_constraintTop_toBottomOf="@id/skeletonTag" />

        <View
            android:id="@+id/skeletonDescription2"
            android:layout_width="0dp"
            android:layout_height="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_50sdp"
            android:background="@drawable/bg_ad_skeleton_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/skeletonButton"
            app:layout_constraintStart_toStartOf="@id/skeletonTag"
            app:layout_constraintTop_toBottomOf="@id/skeletonDescription1" />

        <View
            android:id="@+id/skeletonButton"
            android:layout_width="@dimen/_88sdp"
            android:layout_height="@dimen/_50sdp"
            android:background="@drawable/bg_ad_skeleton_button"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
            Centred on the 60dp content box, which is a fixed height, so the label cannot add to it.
        -->
        <TextView
            android:id="@+id/textAdLoadingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ad_loading_placeholder"
            android:textAppearance="@style/TextAppearance.Ad.LoadingLabel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
