<?xml version="1.0" encoding="utf-8"?>
<!-- Home (Figma 1:2286). The header is a vertical chain of Figma gaps, so a larger font pushes it
     down instead of piling it up: the title 9 px under the status bar, the usage pills 10 px and
     the robot circle 24.6 px under the title, Scan Now 26 px under the circle. The blue header is
     the exported ellipse (762 x 588, top 267 px above the frame) cropped to the part inside the
     frame; it runs from the top of the screen, behind the status bar, to 90.5 px below the top of
     Scan Now, where the ellipse ends in Figma. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.MainActivity">

    <com.phone.cleaner.presentation.components.ScreenBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- The bottom of the status bar; everything below hangs from it. -->
            <Space
                android:id="@+id/status_anchor"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Where the ellipse ends: Figma y 321, 90.5 px below the top of Scan Now. -->
            <Space
                android:id="@+id/header_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/_72sdp"
                app:layout_constraintTop_toTopOf="@id/scan_now" />

            <ImageView
                android:id="@+id/header_background"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/img_home_header"
                app:layout_constraintBottom_toTopOf="@id/header_bottom"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/home_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:fontFamily="@font/roboto_semi_bold"
                android:text="@string/home_title"
                android:textAlignment="viewStart"
                android:textColor="@color/text_on_header"
                android:textDirection="locale"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toStartOf="@id/settings_button"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/status_anchor"
                app:lineHeight="@dimen/_17ssp" />

            <FrameLayout
                android:id="@+id/settings_button"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_settings"
                app:layout_constraintBottom_toBottomOf="@id/home_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/home_title">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="end|center_vertical"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_setting" />
            </FrameLayout>

            <include
                android:id="@+id/storage_pill"
                layout="@layout/item_usage_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_title" />

            <include
                android:id="@+id/ram_pill"
                layout="@layout/item_usage_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_9sdp"
                android:layout_marginEnd="@dimen/_17sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_title" />

            <View
                android:id="@+id/robot_circle"
                android:layout_width="@dimen/_88sdp"
                android:layout_height="@dimen/_88sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/shape_robot_circle"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/home_title" />

            <View
                android:id="@+id/robot_shadow"
                android:layout_width="@dimen/_112sdp"
                android:layout_height="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:background="@drawable/shape_robot_shadow"
                android:importantForAccessibility="no"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/robot_circle" />

            <ImageView
                android:id="@+id/robot"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="@dimen/_98sdp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_robot"
                app:layout_constraintBottom_toBottomOf="@id/robot_circle"
                app:layout_constraintEnd_toEndOf="@id/robot_circle"
                app:layout_constraintStart_toStartOf="@id/robot_circle"
                app:layout_constraintTop_toTopOf="@id/robot_circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scan_now"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_21sdp"
                android:fontFamily="@font/roboto_regular"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:minWidth="@dimen/_138sdp"
                android:minHeight="@dimen/_39sdp"
                android:paddingHorizontal="@dimen/_19sdp"
                android:text="@string/home_scan_now"
                android:textAllCaps="false"
                android:textColor="@color/text_accent"
                android:textSize="@dimen/_13ssp"
                app:backgroundTint="@color/scan_button_surface"
                app:cornerRadius="@dimen/_13sdp"
                app:elevation="0dp"
                app:icon="@drawable/ic_scan_now"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/_10sdp"
                app:iconSize="@dimen/_13sdp"
                app:iconTint="@null"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/robot_circle"
                app:lineHeight="@dimen/_22ssp"
                app:rippleColor="@color/ripple_on_light"
                app:strokeColor="@color/scan_button_stroke"
                app:strokeWidth="@dimen/_1sdp" />

            <TextView
                android:id="@+id/quick_actions_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_16sdp"
                android:layout_marginTop="@dimen/_38sdp"
                android:fontFamily="@font/roboto_semi_bold"
                android:letterSpacing="-0.025"
                android:text="@string/home_quick_actions"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/scan_now"
                app:lineHeight="@dimen/_18ssp" />

            <!-- Each row's children are all match_parent in height, so LinearLayout sizes both cards
                 to the taller one; the gap is the second card's start margin, not a Space, which
                 would stop that. -->
            <LinearLayout
                android:id="@+id/quick_actions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_7sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/quick_actions_title">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/action_junk"
                        layout="@layout/item_quick_action" />

                    <include
                        android:id="@+id/action_duplicates"
                        layout="@layout/item_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/action_app_cleaner"
                        layout="@layout/item_quick_action" />

                    <include
                        android:id="@+id/action_wa_cleaner"
                        layout="@layout/item_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/action_device_info"
                        layout="@layout/item_quick_action" />

                    <include
                        android:id="@+id/action_battery_info"
                        layout="@layout/item_quick_action"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1" />
                </LinearLayout>
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>
