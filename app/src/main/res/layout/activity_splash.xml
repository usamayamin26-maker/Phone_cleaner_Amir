<?xml version="1.0" encoding="utf-8"?>
<!-- Splash (Figma 1:4189). The logo's middle sits 80.75 px above the screen's middle; the title is
     47 px under the logo and the subtitle 7 px under the title. The loading bar (160 x 6) and its
     line, 11 px apart, end 64 px above the bottom.

     Logo, title and subtitle are one packed chain between the top and the loading bar. Its 60.5 px
     top margin puts the logo where the design has it at the default font size; a larger font then
     re-centres the group in the room that is left instead of running it into the loading bar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.onboarding.SplashActivity">

    <com.phone.cleaner.presentation.components.ScreenBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The 20 px blur reaches about 40 px past the 104 px logo on every side. -->
    <View
        android:layout_width="@dimen/_147sdp"
        android:layout_height="@dimen/_147sdp"
        android:background="@drawable/shape_splash_glow"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/logo" />

    <!-- The bottom of the status bar, so the top ad slot starts below the clock rather than under
         it. The slot itself carries constraints and no margin of any kind: the gutter and the
         vertical gap are the slot's own (ads/README.md, "Where a slot's spacing lives"). -->
    <Space
        android:id="@+id/status_anchor"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <com.phone.cleaner.ads.AdSlotView
        android:id="@+id/ad_slot_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_anchor"
        app:nativeMarginHorizontal="@dimen/_14sdp"
        tools:visibility="visible" />

    <FrameLayout
        android:id="@+id/logo"
        android:layout_width="@dimen/_83sdp"
        android:layout_height="@dimen/_83sdp"
        android:layout_marginTop="@dimen/_48sdp"
        android:background="@drawable/shape_splash_logo"
        app:layout_constraintBottom_toTopOf="@id/splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ad_slot_top"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_goneMarginTop="@dimen/_48sdp">

        <ImageView
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sparkle" />
    </FrameLayout>

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_38sdp"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center_horizontal"
        android:letterSpacing="-0.03"
        android:text="@string/splash_title"
        android:textColor="@color/text_label_strong"
        android:textSize="@dimen/_24ssp"
        app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:lineHeight="@dimen/_36ssp" />

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_horizontal"
        android:text="@string/splash_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintBottom_toTopOf="@id/progress_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title"
        app:lineHeight="@dimen/_18ssp" />

    <FrameLayout
        android:id="@+id/progress_track"
        android:layout_width="@dimen/_128sdp"
        android:layout_height="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_9sdp"
        android:background="@drawable/shape_progress_track"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/loading_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/progress_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_progress_fill" />
    </FrameLayout>

    <TextView
        android:id="@+id/loading_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_32sdp"
        android:layout_marginBottom="@dimen/_51sdp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_horizontal"
        android:text="@string/splash_loading"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toTopOf="@id/ad_slot_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="@dimen/_15ssp" />

    <!--
        Continue, in place of the loading row, once a splash full-screen ad has loaded and is
        waiting behind it. The loading bar, its line and this button all end at the same edge of
        the same view, so the swap moves nothing, and nothing above is anchored to any of them -
        the logo chain hangs from the top slot and ends at the loading bar.

        The gesture-bar clearance is written at runtime, not here: whichever of the three is
        bottom-most pays it exactly once (applyNavigationBarBottomMarginAboveSlot, and
        applyNavigationBarBottomMargin on the slot).
    -->
    <FrameLayout
        android:id="@+id/continue_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_14sdp"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/ad_slot_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continue_button"
            style="@style/Widget.PhoneCleaner.PrimaryButton.Rounded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_continue" />
    </FrameLayout>

    <com.phone.cleaner.ads.AdSlotView
        android:id="@+id/ad_slot_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:nativeMarginHorizontal="@dimen/_14sdp"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
