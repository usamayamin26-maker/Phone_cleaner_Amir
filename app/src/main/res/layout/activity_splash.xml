<?xml version="1.0" encoding="utf-8"?>
<!-- Splash (Figma 1:4189). The logo's middle sits 80.75 px above the screen's middle; the title is
     47 px under the logo and the subtitle 7 px under the title. The loading bar (160 x 6) and its
     line, 11 px apart, end 64 px above the bottom.

     Logo, title and subtitle are one packed chain between the top and the loading bar. Its 60.5 px
     top margin puts the logo where the design has it at the default font size; a larger font then
     re-centres the group in the room that is left instead of running it into the loading bar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.onboarding.SplashActivity">

    <com.phone.cleaner.presentation.components.ScreenBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The 20 px blur reaches about 40 px past the 104 px logo on every side. -->
    <View
        android:layout_width="@dimen/_147sdp"
        android:layout_height="@dimen/_147sdp"
        android:background="@drawable/shape_splash_glow"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintEnd_toEndOf="@id/logo"
        app:layout_constraintStart_toStartOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/logo" />

    <FrameLayout
        android:id="@+id/logo"
        android:layout_width="@dimen/_83sdp"
        android:layout_height="@dimen/_83sdp"
        android:layout_marginTop="@dimen/_48sdp"
        android:background="@drawable/shape_splash_logo"
        app:layout_constraintBottom_toTopOf="@id/splash_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <ImageView
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_sparkle" />
    </FrameLayout>

    <TextView
        android:id="@+id/splash_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_38sdp"
        android:fontFamily="@font/roboto_bold"
        android:gravity="center_horizontal"
        android:letterSpacing="-0.03"
        android:text="@string/splash_title"
        android:textColor="@color/text_label_strong"
        android:textSize="@dimen/_24ssp"
        app:layout_constraintBottom_toTopOf="@id/splash_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:lineHeight="@dimen/_36ssp" />

    <TextView
        android:id="@+id/splash_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_horizontal"
        android:text="@string/splash_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_12ssp"
        app:layout_constraintBottom_toTopOf="@id/progress_track"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/splash_title"
        app:lineHeight="@dimen/_18ssp" />

    <FrameLayout
        android:id="@+id/progress_track"
        android:layout_width="@dimen/_128sdp"
        android:layout_height="@dimen/_5sdp"
        android:layout_marginBottom="@dimen/_9sdp"
        android:background="@drawable/shape_progress_track"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/loading_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/progress_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_progress_fill" />
    </FrameLayout>

    <TextView
        android:id="@+id/loading_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_32sdp"
        android:layout_marginBottom="@dimen/_51sdp"
        android:fontFamily="@font/roboto_medium"
        android:gravity="center_horizontal"
        android:text="@string/splash_loading"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:lineHeight="@dimen/_15ssp" />

</androidx.constraintlayout.widget.ConstraintLayout>
