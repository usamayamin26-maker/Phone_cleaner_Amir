<?xml version="1.0" encoding="utf-8"?>
<!-- One Device Info row (Figma 1:1923): a white card, radius 22, 16 px padding; the 40 px tinted
     icon tile, the title and a forward chevron, 12 px apart. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    app:cardBackgroundColor="@color/card_surface"
    app:cardCornerRadius="@dimen/_18sdp"
    app:cardElevation="@dimen/_3sdp"
    app:rippleColor="@color/ripple_on_light"
    android:outlineSpotShadowColor="@color/card_shadow"
    app:strokeWidth="0dp"
    tools:targetApi="28">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/_13sdp">

        <FrameLayout
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/shape_icon_tile">

            <ImageView
                android:id="@+id/section_icon"
                android:layout_width="@dimen/_26sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/section_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_weight="1"
            android:fontFamily="@font/roboto_bold"
            android:textColor="@color/text_title"
            android:textSize="@dimen/_12ssp"
            app:lineHeight="@dimen/_15ssp" />

        <ImageView
            android:layout_width="@dimen/_13sdp"
            android:layout_height="@dimen/_13sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_forward" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
