<?xml version="1.0" encoding="utf-8"?>
<!-- The header of an inner screen (Figma 1:1914): the shared back button and the screen title,
     on a 44 px row with a 14sdp gutter (every inner screen), and an optional trailing control. The title is the same
     on every screen (font, size, gutter, top gap) - never restyle it from a screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/_35sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_14sdp">

    <include
        android:id="@+id/back_button"
        layout="@layout/view_back_button" />

    <TextView
        android:id="@+id/header_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/roboto_semi_bold"
        android:letterSpacing="-0.025"
        android:textColor="@color/text_title"
        android:textSize="@dimen/_14ssp"
        app:lineHeight="@dimen/_17ssp" />

    <!-- Optional trailing control, e.g. "Select All" (Figma 1:687). Empty, it takes no room. -->
    <FrameLayout
        android:id="@+id/header_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

</LinearLayout>
