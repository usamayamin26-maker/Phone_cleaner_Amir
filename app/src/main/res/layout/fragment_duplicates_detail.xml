<?xml version="1.0" encoding="utf-8"?>
<!-- A section's page (Figma 1:661 / 1:827 / 1:738): the shared header with "Select All", then with
     a 20 px gutter, 6 px from the header and 10 px apart: "Keep best one" (photos and videos only)
     and the groups. "Delete" (211 x 50) stays at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include
        android:id="@+id/header"
        layout="@layout/view_inner_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Keep best one (1:692): a 56 px card, radius 28, 16 px padding, label and the switch. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/keep_best"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_5sdp"
        android:outlineSpotShadowColor="@color/card_shadow"
        app:cardBackgroundColor="@color/card_glass"
        app:cardCornerRadius="@dimen/_22sdp"
        app:cardElevation="@dimen/_3sdp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:rippleColor="@color/ripple_on_light"
        app:strokeColor="@color/card_row_stroke"
        app:strokeWidth="@dimen/_1sdp"
        tools:targetApi="28">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/_13sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_10sdp"
                android:layout_weight="1"
                android:fontFamily="@font/roboto_semi_bold"
                android:importantForAccessibility="no"
                android:text="@string/duplicates_keep_best"
                android:textColor="@color/text_label_strong"
                android:textSize="@dimen/_12ssp"
                app:lineHeight="@dimen/_17ssp" />

            <include
                android:id="@+id/keep_best_switch"
                layout="@layout/view_switch" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/groups"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_8sdp"
        android:paddingBottom="@dimen/_4sdp"
        app:layout_constraintBottom_toTopOf="@id/delete_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/keep_best"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_duplicate_group" />

    <!-- Unclipped, so the button's violet shadow shows; its padding is the room it falls into. -->
    <FrameLayout
        android:id="@+id/delete_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_10sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete_button"
            style="@style/Widget.PhoneCleaner.PrimaryButton.Rounded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:fontFamily="@font/roboto_medium"
            android:minWidth="@dimen/_169sdp"
            android:paddingHorizontal="@dimen/_16sdp"
            android:textSize="@dimen/_13ssp"
            app:lineHeight="@dimen/_19ssp"
            tools:text="Delete 2 · 357.47 MB" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
