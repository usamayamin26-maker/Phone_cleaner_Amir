<?xml version="1.0" encoding="utf-8"?>
<!-- The tick at the end of a finished check on the Scan Now scanning page. Stand-in: Figma's badge
     there (1:1684 "Group 7", a blue gradient) is not exported, so the app's own selected-check disc
     is used. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/_16sdp"
    android:layout_height="@dimen/_16sdp"
    android:background="@drawable/shape_check_on"
    android:importantForAccessibility="no">

    <ImageView
        android:layout_width="@dimen/_10sdp"
        android:layout_height="@dimen/_10sdp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick"
        app:tint="@color/icon_on_primary" />
</FrameLayout>
