<?xml version="1.0" encoding="utf-8"?>
<!-- Device Information (Figma 1:1979), and the same layout for Processor, WiFi, Display, RAM, ROM
     and Camera, which have no frame of their own: the section's image in a 125 px tile, then one
     label/value card per value, 12 px apart. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.deviceinfo.DeviceInfoDetailActivity">

    <com.phone.cleaner.presentation.components.ScreenBackgroundView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/header"
        layout="@layout/view_inner_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
        Ad slots. They start GONE, so with this screen's banner/native keys at 0 it measures
        exactly as it did before they were added. The slot carries constraints and no margin of any
        kind: the 14sdp gutter and the vertical gap are the slot's own, in one place for every
        screen in the app (ads/README.md, "Where a slot's spacing lives").
    -->
    <com.phone.cleaner.ads.AdSlotView
        android:id="@+id/ad_slot_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_6sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:nativeMarginHorizontal="@dimen/_14sdp"
        tools:visibility="visible" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/ad_slot_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ad_slot_top"
        app:layout_goneMarginBottom="0dp"
        app:layout_goneMarginTop="0dp">

        <LinearLayout
            android:id="@+id/content_column"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/_10sdp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                app:cardBackgroundColor="@color/header_tile_fill"
                app:cardCornerRadius="@dimen/_23sdp"
                app:cardElevation="@dimen/_4sdp"
                app:strokeColor="@color/header_tile_stroke"
                app:strokeWidth="@dimen/_2sdp">

                <ImageView
                    android:id="@+id/header_image"
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_80sdp"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:importantForAccessibility="no" />
            </com.google.android.material.card.MaterialCardView>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:indeterminateTint="@color/icon_accent"
                android:visibility="gone" />

            <!-- The mid slot, between the section's tile and its rows. A GONE child of a
                 LinearLayout takes its margins with it, so with device_info_detail_mid_* at 0 the
                 tile and the rows sit exactly as they did. -->
            <com.phone.cleaner.ads.AdSlotView
                android:id="@+id/ad_slot_mid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:visibility="gone"
                app:nativeMarginHorizontal="@dimen/_14sdp"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingBottom="@dimen/_22sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_info_row" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.phone.cleaner.ads.AdSlotView
        android:id="@+id/ad_slot_bottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/_4sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:nativeMarginHorizontal="@dimen/_14sdp"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
