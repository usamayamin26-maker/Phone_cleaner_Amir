<?xml version="1.0" encoding="utf-8"?>
<!-- One language (Figma 1:4308): a 68 px card, radius 22, with the flag in a 48 px round tile 15 px
     in, the name 14 px after it and the 21 px tick 15 px from the end on the chosen language. The
     design shows one name; the row shows the language's own name and, under it, its name in the
     app's language. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    android:outlineSpotShadowColor="@color/card_shadow"
    app:cardBackgroundColor="@color/card_row_surface"
    app:cardCornerRadius="@dimen/_18sdp"
    app:cardElevation="@dimen/_3sdp"
    app:rippleColor="@color/ripple_on_light"
    app:strokeColor="@color/card_row_stroke"
    app:strokeWidth="@dimen/_1sdp"
    tools:targetApi="28">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/_54sdp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_12sdp"
        android:paddingVertical="@dimen/_8sdp">

        <TextView
            android:id="@+id/language_flag"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:background="@drawable/shape_circle_tile"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:textColor="@color/text_label_strong"
            android:textSize="@dimen/_20sdp"
            tools:text="🇺🇸" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_11sdp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/language_native"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_bold"
                android:textAlignment="viewStart"
                android:textColor="@color/text_label_strong"
                android:textDirection="locale"
                android:textSize="@dimen/_12ssp"
                app:lineHeight="@dimen/_19ssp"
                tools:text="English" />

            <TextView
                android:id="@+id/language_english"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:textAlignment="viewStart"
                android:textColor="@color/text_tertiary"
                android:textDirection="locale"
                android:textSize="@dimen/_10ssp"
                app:lineHeight="@dimen/_15ssp"
                tools:text="English" />
        </LinearLayout>

        <ImageView
            android:id="@+id/language_tick"
            android:layout_width="@dimen/_17sdp"
            android:layout_height="@dimen/_17sdp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tick" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
