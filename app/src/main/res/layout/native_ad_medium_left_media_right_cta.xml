<?xml version="1.0" encoding="utf-8"?>
<!--
    Native layout 3 (<screen>_<position>_native = 3): [190x120 media] | [icon] [Ad tag + headline / description],
    CTA at the bottom of the right column.
    Content height is fixed (120dp) to match layout_native_ad_skeleton_medium_left_media_right_cta.xml exactly.
    Colors are applied at runtime by NativeAdStyler; the ones set here are the same defaults.
-->
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ad_placeholder"
    android:padding="@dimen/_10sdp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/_120sdp">

        <!-- 190x120dp (AdMob minimum is 120x120) -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media_view"
            android:layout_width="@dimen/_190sdp"
            android:layout_height="@dimen/_120sdp"
            android:background="@color/ad_media_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ad_app_icon"
            android:layout_width="@dimen/_54sdp"
            android:layout_height="@dimen/_54sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toEndOf="@id/ad_media_view"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.NativeAd.Icon" />

        <TextView
            android:id="@+id/tvAdBadge"
            android:fontFamily="@font/roboto_regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@drawable/bg_native_ad_tag"
            android:paddingStart="@dimen/_5sdp"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/_5sdp"
            android:paddingBottom="0dp"
            android:text="@string/ad_attribution"
            android:textColor="@color/native_ad_tag_text"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/ad_headline"
            app:layout_constraintStart_toEndOf="@id/ad_app_icon"
            app:layout_constraintTop_toTopOf="@id/ad_headline"
            app:layout_goneMarginStart="@dimen/_10sdp" />

        <!-- 20dp end margin keeps the headline clear of the AdChoices icon in the top-right corner -->
        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            android:ellipsize="end"
            android:fontFamily="@font/roboto_semi_bold"
            android:maxLines="1"
            android:textColor="@color/native_ad_heading"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintBottom_toTopOf="@id/ad_body"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvAdBadge"
            app:layout_constraintTop_toTopOf="@id/ad_app_icon"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0" />

        <TextView
            android:id="@+id/ad_body"
            android:fontFamily="@font/roboto_regular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/native_ad_description"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toBottomOf="@id/ad_app_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvAdBadge"
            app:layout_constraintTop_toBottomOf="@id/ad_headline" />

        <Button
            android:id="@+id/ad_call_to_action"
            android:layout_width="0dp"
            android:layout_height="@dimen/_50sdp"
            android:layout_marginStart="@dimen/_10sdp"
            android:background="@drawable/bg_native_ad_button"
            android:fontFamily="@font/roboto_semi_bold"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:textAllCaps="false"
            android:textColor="@color/native_ad_button_text"
            android:textSize="@dimen/_15ssp"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ad_media_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.gms.ads.nativead.NativeAdView>
