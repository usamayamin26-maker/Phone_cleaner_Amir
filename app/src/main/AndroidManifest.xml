<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Feature permissions are declared in each library module's own manifest and merged here.
         requestLegacyExternalStorage below keeps Android 10 on the pre-scoped-storage rules, so
         the cleaners work there with the old storage permission; Android 11+ ignores it. -->

    <!-- FCM notifications on Android 13+; asked once, the first time Home is on screen. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BaseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneCleaner"
        tools:targetApi="33">

        <activity
            android:name=".presentation.onboarding.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.PhoneCleaner.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".presentation.onboarding.LanguageActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.PhoneCleaner.Home"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".presentation.onboarding.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.settings.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.appmanager.AppCleanerActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.duplicates.DuplicatesActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.aicleaner.AiCleanerActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.whatsapp.WaCleanerActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.junkcleaner.ScanNowActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.deviceinfo.DeviceInfoActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.deviceinfo.DeviceInfoDetailActivity"
            android:exported="false" />

        <activity
            android:name=".presentation.battery.BatteryInfoActivity"
            android:exported="false" />

        <!-- FCM (Firebase Cloud Messaging): the default channel and small icon the SDK uses when it
             draws a notification itself (app in the background). The icon is a white silhouette. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- AdMob application id. The Mobile Ads SDK reads it from the manifest, not from Remote
             Config, and throws on initialize() if it is missing or malformed. Google's published
             TEST app id for now; the real one is item 3 of docs/release-checklist.md. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6439059775801210~5510985504" />

        <service
            android:name=".messaging.AppFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
